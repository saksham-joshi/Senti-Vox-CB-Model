{
  "about": "Shared test vectors for the SentiVox tokenizer. Every port (Python, TypeScript, Java) must produce exactly 'expected' for 'input'; the cleaned text is the tokens joined with single spaces. Options: normalize (default 'NFKC', null = off), lowercase (default true), demojize (default true). Invisible characters are written as \\u escapes on purpose.",
  "cases": [
    {
      "name": "english basic",
      "input": "This movie was GOOD!",
      "options": {},
      "expected": [
        "this",
        "movie",
        "was",
        "good",
        "!"
      ]
    },
    {
      "name": "lowercase off keeps case but folds shouting",
      "input": "This movie was GOOD!",
      "options": {
        "lowercase": false
      },
      "expected": [
        "This",
        "movie",
        "was",
        "good",
        "!"
      ]
    },
    {
      "name": "empty string",
      "input": "",
      "options": {},
      "expected": []
    },
    {
      "name": "only whitespace",
      "input": "   \n\t \r\n ",
      "options": {},
      "expected": []
    },
    {
      "name": "initialism",
      "input": "U.S.A rocks",
      "options": {},
      "expected": [
        "u",
        ".",
        "s",
        ".",
        "a",
        "rocks"
      ]
    },
    {
      "name": "contractions",
      "input": "I don't like it, can’t stand it",
      "options": {},
      "expected": [
        "i",
        "don't",
        "like",
        "it",
        ",",
        "can't",
        "stand",
        "it"
      ]
    },
    {
      "name": "curly apostrophe kept when normalize is off",
      "input": "can’t",
      "options": {
        "normalize": null
      },
      "expected": [
        "can’t"
      ]
    },
    {
      "name": "apostrophe edges",
      "input": "'quoted' dogs' rock'n'roll",
      "options": {},
      "expected": [
        "'",
        "quoted",
        "'",
        "dogs",
        "'",
        "rock'n'roll"
      ]
    },
    {
      "name": "negations and stopwords are kept",
      "input": "not bad at all, not good either",
      "options": {},
      "expected": [
        "not",
        "bad",
        "at",
        "all",
        ",",
        "not",
        "good",
        "either"
      ]
    },
    {
      "name": "danda is punctuation",
      "input": "मैं बहुत खुश हूँ। सच में।",
      "options": {},
      "expected": [
        "मैं",
        "बहुत",
        "खुश",
        "हूँ",
        "।",
        "सच",
        "में",
        "।"
      ]
    },
    {
      "name": "double danda",
      "input": "राम॥",
      "options": {},
      "expected": [
        "राम",
        "॥"
      ]
    },
    {
      "name": "digits are kept",
      "input": "साल२५ और abc123",
      "options": {},
      "expected": [
        "साल",
        "२५",
        "और",
        "abc123"
      ]
    },
    {
      "name": "digits of any script make one number",
      "input": "12३",
      "options": {},
      "expected": [
        "12३"
      ]
    },
    {
