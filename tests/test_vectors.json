{
 "about": "Shared test vectors for the SentiVox tokenizer. Every port (Python, TypeScript, Java) must produce exactly 'expected' for 'input'. Options: normalize (default 'NFKC', null = off), lowercase (default false). Invisible characters are written as \\u escapes on purpose.",
 "cases": [
  {"name": "english basic", "input": "This movie was GOOD!", "options": {}, "expected": ["This", "movie", "was", "GOOD"]},
  {"name": "english lowercase option", "input": "This movie was GOOD!", "options": {"lowercase": true}, "expected": ["this", "movie", "was", "good"]},
  {"name": "empty string", "input": "", "options": {}, "expected": []},
  {"name": "only whitespace", "input": "   \n\t \r\n ", "options": {}, "expected": []},
  {"name": "initialism", "input": "U.S.A rocks", "options": {}, "expected": ["U", "S", "A", "rocks"]},
  {"name": "contractions", "input": "I don't like it, can’t stand it", "options": {}, "expected": ["I", "don't", "like", "it", "can't", "stand", "it"]},
  {"name": "curly apostrophe kept when normalize is off", "input": "can’t", "options": {"normalize": null}, "expected": ["can’t"]},
  {"name": "apostrophe edges", "input": "'quoted' dogs' rock'n'roll", "options": {}, "expected": ["quoted", "dogs", "rock'n'roll"]},
  {"name": "danda is not part of the word", "input": "मैं बहुत खुश हूँ। सच में।", "options": {}, "expected": ["मैं", "बहुत", "खुश", "हूँ", "सच", "में"]},
  {"name": "double danda", "input": "राम॥", "options": {}, "expected": ["राम"]},
  {"name": "devanagari and ascii digits are dropped", "input": "साल२५ और abc123", "options": {}, "expected": ["साल", "और", "abc"]},
  {"name": "digits of any script are dropped", "input": "12३", "options": {}, "expected": []},
  {"name": "arabic-indic digits are dropped", "input": "٢٠٢٦ و ۲۰۲۶", "options": {}, "expected": ["و"]},
  {"name": "mixed scripts without a space", "input": "हैLove", "options": {}, "expected": ["है", "Love"]},
  {"name": "bengali ya-phala keeps ZWJ", "input": "র\u200d্যাব ভালো", "options": {}, "expected": ["র\u200d্যাব", "ভালো"]},
  {"name": "hindi conjunct keeps ZWJ", "input": "क्\u200dष", "options": {}, "expected": ["क्\u200dष"]},
  {"name": "trailing ZWNJ is dropped", "input": "कर\u200c हूँ", "options": {}, "expected": ["कर", "हूँ"]},
  {"name": "lone ZWJ between words is ignored", "input": "a \u200d b", "options": {}, "expected": ["a", "b"]},
  {"name": "CRLF", "input": "good\r\nbad", "options": {}, "expected": ["good", "bad"]},
  {"name": "nbsp and ideographic space", "input": "good\u00a0bad\u3000ok", "options": {}, "expected": ["good", "bad", "ok"]},
  {"name": "nbsp and ideographic space, normalize off", "input": "good\u00a0bad\u3000ok", "options": {"normalize": null}, "expected": ["good", "bad", "ok"]},
  {"name": "zwsp and bom", "input": "\ufeffgood\u200bbad", "options": {}, "expected": ["good", "bad"]},
  {"name": "control chars separate tokens", "input": "a\u0000b", "options": {}, "expected": ["a", "b"]},
  {"name": "stray variation selector", "input": "ok\ufe0f", "options": {}, "expected": ["ok"]},
  {"name": "accented latin", "input": "café naïve shukriyā", "options": {}, "expected": ["café", "naïve", "shukriyā"]},
  {"name": "urdu", "input": "یہ بہت اچھا ہے۔", "options": {}, "expected": ["یہ", "بہت", "اچھا", "ہے"]},
  {"name": "odia", "input": "ଏହା ବହୁତ ଭଲ", "options": {}, "expected": ["ଏହା", "ବହୁତ", "ଭଲ"]},
  {"name": "bengali", "input": "খুব ভালো", "options": {}, "expected": ["খুব", "ভালো"]},
  {"name": "telugu", "input": "చాలా బాగుంది", "options": {}, "expected": ["చాలా", "బాగుంది"]},
  {"name": "kannada", "input": "ತುಂಬಾ ಚೆನ್ನಾಗಿದೆ", "options": {}, "expected": ["ತುಂಬಾ", "ಚೆನ್ನಾಗಿದೆ"]},
  {"name": "malayalam", "input": "വളരെ നല്ലത്", "options": {}, "expected": ["വളരെ", "നല്ലത്"]},
  {"name": "gujarati", "input": "ખૂબ સરસ છે", "options": {}, "expected": ["ખૂબ", "સરસ", "છે"]},
  {"name": "gurmukhi", "input": "ਬਹੁਤ ਵਧੀਆ ਹੈ", "options": {}, "expected": ["ਬਹੁਤ", "ਵਧੀਆ", "ਹੈ"]},
  {"name": "marathi with danda", "input": "खूप छान आहे।", "options": {}, "expected": ["खूप", "छान", "आहे"]},
  {"name": "tamil", "input": "இந்த படம் மிகவும் நன்றாக உள்ளது.", "options": {}, "expected": ["இந்த", "படம்", "மிகவும்", "நன்றாக", "உள்ளது"]},
  {"name": "unlisted scripts fall back to letter runs", "input": "Привет мир 日本語abc", "options": {}, "expected": ["Привет", "мир", "日本語", "abc"]},
  {"name": "emoji sequences", "input": "great 👍🏽 and ❤\ufe0f and 👨\u200d👩\u200d👧 🇮🇳 end", "options": {}, "expected": ["great", "👍🏽", "and", "❤\ufe0f", "and", "👨\u200d👩\u200d👧", "🇮🇳", "end"]},
  {"name": "repeated emoji are separate tokens", "input": "😂😂😂", "options": {}, "expected": ["😂", "😂", "😂"]},
  {"name": "keycap", "input": "1\ufe0f⃣ 2", "options": {}, "expected": ["1\ufe0f⃣"]},
  {"name": "emoji glued to a word", "input": "wow🔥", "options": {}, "expected": ["wow", "🔥"]},
  {"name": "emoticons", "input": "good:) bad :( <3 :D :Dog", "options": {}, "expected": ["good", ":)", "bad", ":(", "<3", ":D", "Dog"]},
  {"name": "hashtag and mention", "input": "#awesome @user", "options": {}, "expected": ["awesome", "user"]},
  {"name": "numbers, currency and punctuation are dropped", "input": "rated 4.5/5 for ₹1,000", "options": {}, "expected": ["rated", "for"]},
  {"name": "fullwidth and math bold letters", "input": "Ｇｏｏｄ 𝐇𝐞𝐥𝐥𝐨", "options": {}, "expected": ["Good", "Hello"]},
  {"name": "nukta precomposed", "input": "क़", "options": {}, "expected": ["क़"]},
  {"name": "nukta decomposed", "input": "क़", "options": {}, "expected": ["क़"]},
  {"name": "nukta precomposed, normalize off", "input": "क़", "options": {"normalize": null}, "expected": ["क़"]},
  {"name": "plain url", "input": "see https://example.com/a?b=1 now", "options": {}, "expected": ["see", "now"]},
  {"name": "url with parens and trailing punctuation", "input": "(see https://en.wikipedia.org/wiki/Foo_(bar)). ok", "options": {}, "expected": ["see", "ok"]},
  {"name": "url followed by hindi without a space", "input": "देखो https://x.com/abcबहुत अच्छा", "options": {}, "expected": ["देखो", "बहुत", "अच्छा"]},
  {"name": "www and bare domain with path", "input": "visit www.example.com or bit.ly/xyz today", "options": {}, "expected": ["visit", "or", "today"]},
  {"name": "bare domain without path stays", "input": "go to example.com now", "options": {}, "expected": ["go", "to", "example", "com", "now"]},
  {"name": "lookalike is not a url", "input": "Mr.Smith/John", "options": {}, "expected": ["Mr", "Smith", "John"]},
  {"name": "emails", "input": "mail josé@example.com or a.b+c@d.co.in please", "options": {}, "expected": ["mail", "or", "please"]},
  {"name": "url between words does not glue them", "input": "great http://a.com stuff", "options": {}, "expected": ["great", "stuff"]},
  {"name": "markdown asterisks around a url", "input": "*https://y.com* ok", "options": {}, "expected": ["ok"]},
  {"name": "keycap after a digit run", "input": "33⃣", "options": {}, "expected": ["3⃣"]},
  {"name": "nothing but numbers and punctuation", "input": "!!! 123, ... ₹ 4.5/5 ?", "options": {}, "expected": []}
 ]
}
